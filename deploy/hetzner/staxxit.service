[Unit]
Description=Staxxit (Node.js + Socket.IO)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/staxxit
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
# Optional: EnvironmentFile=/var/www/staxxit/.env
ExecStart=/usr/bin/node /var/www/staxxit/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
